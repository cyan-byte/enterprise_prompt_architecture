{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "review-classification-contract",
  "title": "ModelOutputContract",
  "description": "The only thing the model is allowed to return. Provenance, consent and approval are owned by code, never by the model.",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "na_reason", "evidence"],
  "properties": {
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "confidence", "rationale"],
      "properties": {
        "label": {
          "type": "string",
          "enum": ["positive", "negative", "neutral", "na"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      }
    },
    "na_reason": {
      "type": ["string", "null"],
      "enum": ["empty_input", "not_a_review", "wrong_language", "insufficient_evidence", null]
    },
    "evidence": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "note"],
        "properties": {
          "url": {"type": "string", "minLength": 1},
          "note": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
